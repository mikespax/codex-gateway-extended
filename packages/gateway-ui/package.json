{
  "name": "@codex-gateway/ui",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./tailwind.css"
  ],
  "exports": {
    "./tailwind.css": "./tailwind.css",
    "./utils": {
      "types": "./dist/types/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./*": {
      "types": "./dist/types/*/index.d.ts",
      "import": "./dist/*/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && vite build && vue-tsc -p tsconfig.json --declaration --emitDeclarationOnly --outDir dist/types",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.2",
    "@lucide/vue": "^1.27.0",
    "@tanstack/vue-table": "^8.21.3",
    "@unovis/vue": "^1.6.7",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-vue": "^8.6.0",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "vue-input-otp": "^0.3.2",
    "vue-sonner": "^2.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite": "8.1.5",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.8"
  },
  "peerDependencies": {
    "vue": "^3.5.40"
  }
}
