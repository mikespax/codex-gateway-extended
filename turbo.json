{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "scripts/**",
        "package.json",
        "tsconfig.json",
        "vite.config.ts",
        "rolldown.config.ts"
      ],
      "outputs": ["dist/**"]
    }
  }
}
